# ACPIA BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and substitute your live API keys when DEMO_MODE=false

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Demo Mode Toggle
# When true, all AI external API calls are safely simulated using realistic mock data in /backend/mock_data/
# Set to false when using live API keys below.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# 1. Google Gemini API Key
# Used for: Content Analysis Agent, Metadata Extraction, Correlation Agent, Timeline Reconstruction, Validator Agent, and Executive Report Synthesis.
# Obtain from: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. Anthropic Claude API Key (Optional Fallback)
# Used for: Content Analysis & LLM text processing fallback
# Obtain from: https://console.anthropic.com/
# -----------------------------------------------------------------------------
CLAUDE_API_KEY=your_anthropic_claude_api_key_here

# -----------------------------------------------------------------------------
# 3. Google Cloud Vision API Key (Optional Image Safety Scanner)
# Used for: SafeSearch image likelihood score classification in Content Analysis Agent
# Obtain from: https://console.cloud.google.com/apis/credentials
# Note: If unset, GEMINI_API_KEY or DEMO_MODE fallback will be used automatically.
# -----------------------------------------------------------------------------
VISION_API_KEY=your_google_vision_api_key_here

# -----------------------------------------------------------------------------
# 4. Hugging Face API Key
# Used for: Synthetic Detection Agent (Deepfake / AI-generated image detection model)
# Obtain from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_API_KEY=your_huggingface_api_key_here
